digraph G {
  graph [rankdir=LR fontname="Helvetica" nodesep=0.4 ranksep=0.8 labelloc=t label=<<B>CertiTrust - UML class diagram (entities)</B>> fontsize=20 pad=0.4 bgcolor=white ];
  node [fontname="Helvetica" fontsize=11];
  edge [fontname="Helvetica" fontsize=10];
  User [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#bfdbfe"><FONT POINT-SIZE="10">&laquo;entity&raquo;</FONT><BR/><B>User</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- name: String<BR ALIGN="LEFT"/>- email: String  {unique}<BR ALIGN="LEFT"/>- password: String  (BCrypt)<BR ALIGN="LEFT"/>- role: Role<BR ALIGN="LEFT"/>- enabled: boolean<BR ALIGN="LEFT"/>- createdAt: LocalDateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Inst [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#bbf7d0"><FONT POINT-SIZE="10">&laquo;entity&raquo;</FONT><BR/><B>Institution</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- name: String  {unique}<BR ALIGN="LEFT"/>- address, email, website: String<BR ALIGN="LEFT"/>- status: InstitutionStatus<BR ALIGN="LEFT"/>- logoPath: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Cert [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#fde68a"><FONT POINT-SIZE="10">&laquo;entity&raquo;</FONT><BR/><B>Certificate</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- certificateId: String  {unique}<BR ALIGN="LEFT"/>- recipientName, recipientEmail: String<BR ALIGN="LEFT"/>- course: String<BR ALIGN="LEFT"/>- certificateType: CertificateType<BR ALIGN="LEFT"/>- institutionName: String<BR ALIGN="LEFT"/>- issueDate, expiryDate: LocalDate<BR ALIGN="LEFT"/>- grade, additionalInfo: String<BR ALIGN="LEFT"/>- status: CertificateStatus<BR ALIGN="LEFT"/>- certificateHash: String  (SHA-256)<BR ALIGN="LEFT"/>- qrCodePath, pdfPath: String<BR ALIGN="LEFT"/>- verificationCount: long<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ isExpired(): boolean<BR ALIGN="LEFT"/>+ getDisplayStatus(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Rev [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#fecaca"><FONT POINT-SIZE="10">&laquo;entity&raquo;</FONT><BR/><B>Revocation</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- reason: String<BR ALIGN="LEFT"/>- revokedAt: LocalDateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  VLog [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="10">&laquo;entity&raquo;</FONT><BR/><B>VerificationLog</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- certificateId: String<BR ALIGN="LEFT"/>- verificationTime: LocalDateTime<BR ALIGN="LEFT"/>- verificationStatus: VerificationStatus<BR ALIGN="LEFT"/>- ipAddress: String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Audit [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#e5e7eb"><FONT POINT-SIZE="10">&laquo;entity&raquo;</FONT><BR/><B>AuditLog</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- action: String<BR ALIGN="LEFT"/>- actor: String<BR ALIGN="LEFT"/>- details: String<BR ALIGN="LEFT"/>- ipAddress: String<BR ALIGN="LEFT"/>- createdAt: LocalDateTime<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Cert -> User [arrowhead=vee taillabel="*" headlabel="1 issuer"];
  Cert -> Inst [arrowhead=vee taillabel="*" headlabel="1"];
  User -> Inst [arrowhead=vee taillabel="*" headlabel="0..1"];
  Rev -> Cert [arrowhead=vee taillabel="*" headlabel="1"];
  Rev -> User [arrowhead=vee taillabel="*" headlabel="1 revokedBy"];
  VLog -> User [arrowhead=vee taillabel="*" headlabel="0..1 verifier"];
}
