digraph G {
  graph [rankdir=LR fontname="Helvetica" nodesep=0.6 ranksep=1.4 labelloc=t label=<<B>CertiTrust - database structure (ER diagram)</B>> fontsize=20 pad=0.4 bgcolor=white ];
  node [fontname="Helvetica" fontsize=11];
  edge [fontname="Helvetica" fontsize=10];
  edge [dir=both arrowtail=tee arrowhead=crow];
  inst [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#bbf7d0"><B>institutions</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">address</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">website</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">ACTIVE | DISABLED</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">logo_path</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR></TABLE>>];
  users [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#bfdbfe"><B>users</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(100) BCrypt</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">role</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">ADMIN | ISSUER | VERIFIER</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">enabled</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BOOLEAN</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">institution_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">-&gt; institutions (null ok)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATETIME</FONT></TD></TR></TABLE>>];
  certs [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fde68a"><B>certificates</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>UQ</B></TD><TD ALIGN="LEFT">certificate_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">recipient_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(120)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">recipient_email</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">course</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(200)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">certificate_type</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">institution_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">-&gt; institutions</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">institution_name</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">issuer_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">-&gt; users</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">issue_date, expiry_date</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATE</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">grade, additional_info</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">ACTIVE | REVOKED</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">certificate_hash</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(64) SHA-256</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">qr_code_path, pdf_path</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">verification_count</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATETIME</FONT></TD></TR></TABLE>>];
  rev [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#fecaca"><B>revocations</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">certificate_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">-&gt; certificates</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">revoked_by</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">-&gt; users</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">reason</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">revoked_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATETIME</FONT></TD></TR></TABLE>>];
  vlog [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e9d5ff"><B>verification_logs</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">certificate_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(64) text</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">verification_time</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">verification_status</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>FK</B></TD><TD ALIGN="LEFT">verifier_id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">-&gt; users (null = anonymous)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(64)</FONT></TD></TR></TABLE>>];
  audit [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#e5e7eb"><B>audit_logs</B></TD></TR><TR><TD ALIGN="LEFT"><B>PK</B></TD><TD ALIGN="LEFT">id</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">action</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(50)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">actor</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(150)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">details</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(500)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">ip_address</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">VARCHAR(64)</FONT></TD></TR><TR><TD ALIGN="LEFT"><B>&nbsp;</B></TD><TD ALIGN="LEFT">created_at</TD><TD ALIGN="LEFT"><FONT COLOR="#555555">DATETIME</FONT></TD></TR></TABLE>>];
  inst -> users [taillabel="1" headlabel="0..*"];
  inst -> certs [taillabel="1" headlabel="0..*"];
  users -> certs [taillabel="1 issuer" headlabel="0..*"];
  certs -> rev [taillabel="1" headlabel="0..*"];
  users -> rev [taillabel="1" headlabel="0..*"];
  users -> vlog [taillabel="0..1" headlabel="0..*"];
  certs -> vlog [style=dashed arrowtail=none arrowhead=none label="logical link: certificate_id"];
}
