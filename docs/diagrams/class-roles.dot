digraph G {
  graph [rankdir=BT fontname="Helvetica" nodesep=0.4 ranksep=0.8 labelloc=t label=<<B>CertiTrust - UML class diagram (1/3: account roles - inheritance)</B>> fontsize=20 pad=0.4 bgcolor=white ];
  node [fontname="Helvetica" fontsize=11];
  edge [fontname="Helvetica" fontsize=10];
  Account [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#fde68a"><FONT POINT-SIZE="10">&laquo;abstract&raquo;</FONT><BR/><I><B>Account</B></I></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- id: Long<BR ALIGN="LEFT"/>- name: String<BR ALIGN="LEFT"/>- email: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ role(): Role  {abstract}<BR ALIGN="LEFT"/>+ permissions(): Set&lt;Permission&gt;  {abstract}<BR ALIGN="LEFT"/>+ dashboardPath(): String  {abstract}<BR ALIGN="LEFT"/>+ can(Permission): boolean<BR ALIGN="LEFT"/>+ can(String): boolean<BR ALIGN="LEFT"/>+ describe(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Admin [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#bbf7d0"><B>AdministratorAccount</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ role(): Role<BR ALIGN="LEFT"/>+ permissions(): Set&lt;Permission&gt;<BR ALIGN="LEFT"/>+ dashboardPath(): String<BR ALIGN="LEFT"/>+ describe(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Issuer [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#bbf7d0"><B>IssuerAccount</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">- institutionName: String<BR ALIGN="LEFT"/></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ role(): Role<BR ALIGN="LEFT"/>+ permissions(): Set&lt;Permission&gt;<BR ALIGN="LEFT"/>+ dashboardPath(): String<BR ALIGN="LEFT"/>+ describe(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Verifier [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#bbf7d0"><B>VerifierAccount</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ role(): Role<BR ALIGN="LEFT"/>+ permissions(): Set&lt;Permission&gt;<BR ALIGN="LEFT"/>+ dashboardPath(): String<BR ALIGN="LEFT"/>+ describe(): String<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Perm [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#e9d5ff"><FONT POINT-SIZE="10">&laquo;enum&raquo;</FONT><BR/><B>Permission</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">MANAGE_USERS<BR ALIGN="LEFT"/>MANAGE_INSTITUTIONS<BR ALIGN="LEFT"/>ISSUE_CERTIFICATES<BR ALIGN="LEFT"/>REVOKE_CERTIFICATES<BR ALIGN="LEFT"/>VERIFY_CERTIFICATES<BR ALIGN="LEFT"/>SEARCH_CERTIFICATES<BR ALIGN="LEFT"/>VIEW_HISTORY<BR ALIGN="LEFT"/>VIEW_AUDIT_AND_REPORTS<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Accounts [shape=plaintext label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="5" BGCOLOR="white"><TR><TD BGCOLOR="#e5e7eb"><FONT POINT-SIZE="10">&laquo;factory&raquo;</FONT><BR/><B>Accounts</B></TD></TR><TR><TD ALIGN="LEFT" BALIGN="LEFT">+ create(id, name, email, role, institution): Account<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  Admin -> Account [arrowhead=empty];
  Issuer -> Account [arrowhead=empty];
  Verifier -> Account [arrowhead=empty];
  Account -> Perm [style=dashed arrowhead=vee label="uses" constraint=false];
  Accounts -> Account [style=dashed arrowhead=vee label="creates" constraint=false];
}
